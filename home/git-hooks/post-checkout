#!/usr/bin/env bash
set -euo pipefail

# Git calls this hook after worktree creation with a null old HEAD. Ignore
# ordinary branch switches, including repositories using SHA-256 object IDs.
if [[ ! "$1" =~ ^0+$ || "$3" != "1" ]]; then
  exit 0
fi

original_worktree="${WORKTREE_SOURCE_DIRECTORY:-}"
if [[ -z "$original_worktree" ]]; then
  while IFS= read -r -d '' line; do
    case "$line" in
      "worktree "*)
        original_worktree="${line#worktree }"
        break
        ;;
    esac
  done < <(git worktree list --porcelain -z)
fi

[[ -n "$original_worktree" ]] || exit 0
worktree --prepare "$original_worktree" "$PWD" > /dev/null
